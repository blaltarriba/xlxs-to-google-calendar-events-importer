# Copy to .env and fill in. .env is gitignored and must never be committed.

SCHEDULE_FILE=Calendario 2627 L,M,M.xlsx
TRAINING_WEEKDAY=tuesday
CALENDAR_NAME=Golf training

# Your wife's Google account — she is added as a guest on every event.
INVITEE_EMAIL=

# Event content. Placeholders: {session} {total} {date} {location}
# Use \n in the description for line breaks.
EVENT_TITLE_TEMPLATE=Entrenamiento {session}/{total}
EVENT_DESCRIPTION_TEMPLATE=Entrenamiento \nSesión {session} de {total}
EVENT_LOCATION=Fake location

START_TIME=17:30
END_TIME=19:30
TIMEZONE=Europe/Madrid

GOOGLE_CLIENT_SECRET_FILE=client_secret.json
GOOGLE_TOKEN_FILE=token.json

# The 31 May – 6 Jun 2027 row in the sheet is tinted a flat grey across all seven
# days, which wiped that week's per-day session colours. The sheet header says
# "30 martes" and the footnote says session 30 is 8 June, so 1 June is session 29.
EXTRA_SESSION_DATES=2027-06-01
